{
  "name": "vibecheck",
  "version": "0.1.0",
  "description": "Security scanner for AI-generated (\"vibe-coded\") apps",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "vibecheck": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli.ts",
    "fixtures:generate": "node fixtures/generate.js",
    "scan:fixture": "npm run build && npm run fixtures:generate && node dist/cli.js scan --local ./fixtures/vulnerable-app"
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
